{
  "name": "YouTube Playlist Duration",
  "version": "0.1.0",
  "description": "Displays the total duration of YouTube playlists",
  "manifest_version": 3,
  "action": {},
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-playlist-duration@furumo.eu",
      "strict_min_version": "128.0"
    }
  }
}
