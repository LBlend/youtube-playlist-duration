{
  "name": "Playlist Duration for YouTube",
  "version": "0.3.0",
  "description": "Displays the total duration of YouTube playlists",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-playlist-duration@furumo.eu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  }
}
